{
  "name": "library-api",
  "version": "1.0.0",
  "description": "API RESTful para gerenciamento de biblioteca (livros, usuarios e emprestimos) construida com Clean Architecture, DDD, Strategy e Factory Method.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "swagger": "node swagger.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "prisma",
    "sqlite",
    "clean-architecture",
    "ddd",
    "solid",
    "strategy",
    "factory-method"
  ],
  "author": "Integrante 1 e Integrante 2",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "swagger-autogen": "^2.23.7"
  }
}

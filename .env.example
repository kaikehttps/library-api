# Copie este arquivo para ".env" antes de rodar o projeto:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env

# Conexao do Prisma com o SQLite.
# O caminho e relativo a pasta "prisma/", portanto o banco sera criado em prisma/dev.db
DATABASE_URL="file:./dev.db"

# Porta HTTP da API
PORT=3000

# Ambiente de execucao (development | test | production)
NODE_ENV=development
